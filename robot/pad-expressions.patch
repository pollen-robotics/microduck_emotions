+++ b/padd/src/cue.rs
@@ -0,0 +1,169 @@
+//! Scripted cues over TCP: a scene player on the LAN (the theater's `skit.py`, running on the
+//! Reachy Mini or a laptop) tells the pad daemon to play an emotion, a skill, a sound or a short
+//! walk, exactly as a button press would — so the sticks stay alive underneath and the pad's
+//! own rules (one expression at a time, Start / Select untouched) keep holding.
+//!
+//! Wire: one JSON object per line, one JSON answer per line, on `--cue-port` (7777 by default,
+//! all interfaces: the robot lives on a home LAN and the cues are what a button does).
+//!
+//! ```text
+//! {"express":"yes"}                -> {"ok":true,"duration":1.4}
+//! {"skill":"ground_pick"}          -> {"ok":true}
+//! {"sound":"chirp"}                -> {"ok":true}
+//! {"move":[0.3,0,0],"for":1.5}     -> {"ok":true,"duration":1.5}
+//! {"stop":true}                    -> {"ok":true}     (ends the expression and the scripted move)
+//! {"ping":true}                    -> {"ok":true,"kinds":[...]}
+//! ```
+//!
+//! The listener thread only parses and queues; the pad loop applies the cues on its next tick,
+//! which is where every robot intent of `padd` is sent from. A cue that cannot be applied
+//! there (no pad connected: the loop is idle) is answered `ok` here and dropped there, with a
+//! warning in the journal — the scene player cannot know better than the operator does.
+
+use std::io::{BufRead, BufReader, Write};
+use std::net::{TcpListener, TcpStream};
+use std::sync::mpsc::{self, Receiver, Sender};
+
+use duck_ipc_proto as proto;
+use serde::Deserialize;
+
+use crate::expressions::{Expression, Kind};
+
+/// One cue, as the pad loop sees it.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Cue {
+    Express(Kind),
+    Skill(proto::Skill),
+    Sound(proto::SoundTag),
+    /// A twist held for this many seconds, overriding the sticks meanwhile.
+    Move(proto::MoveParams, f64),
+    Stop,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Wire {
+    express: Option<String>,
+    skill: Option<proto::Skill>,
+    sound: Option<proto::SoundTag>,
+    #[serde(rename = "move")]
+    move_: Option<[f64; 3]>,
+    #[serde(rename = "for")]
+    for_: Option<f64>,
+    stop: Option<bool>,
+    ping: Option<bool>,
+}
+
+/// Parse one line into a cue and its answer. `Ok(None)` is a ping: answered, nothing queued.
+fn parse(line: &str) -> Result<(Option<Cue>, String), String> {
+    let w: Wire = serde_json::from_str(line).map_err(|e| e.to_string())?;
+    if w.ping == Some(true) {
+        let kinds: Vec<&str> = Kind::NAMES.iter().map(|(n, _)| *n).collect();
+        return Ok((None, format!("{{\"ok\":true,\"kinds\":{}}}", serde_json::to_string(&kinds).unwrap_or_default())));
+    }
+    if w.stop == Some(true) {
+        return Ok((Some(Cue::Stop), "{\"ok\":true}".to_owned()));
+    }
+    if let Some(name) = w.express {
+        let kind = Kind::from_name(&name).ok_or_else(|| format!("unknown expression {name:?}"))?;
+        let d = Expression::duration(kind).as_secs_f64();
+        return Ok((Some(Cue::Express(kind)), format!("{{\"ok\":true,\"duration\":{d:.2}}}")));
+    }
+    if let Some(skill) = w.skill {
+        // Nominal lengths, so a scene can hold for them: the ground pick's phase runs 4 s, the
+        // sit lands in about 2.5 s, a kick is half a second, a roll about a second and a half.
+        let d = match skill {
+            proto::Skill::GroundPick => 4.0,
+            proto::Skill::SitToggle => 2.5,
+            proto::Skill::KickLeft | proto::Skill::KickRight => 0.6,
+            proto::Skill::Roulade => 1.5,
+        };
+        return Ok((Some(Cue::Skill(skill)), format!("{{\"ok\":true,\"duration\":{d:.2}}}")));
+    }
+    if let Some(tag) = w.sound {
+        return Ok((Some(Cue::Sound(tag)), "{\"ok\":true}".to_owned()));
+    }
+    if let Some([vx, vy, vyaw]) = w.move_ {
+        let secs = w.for_.unwrap_or(1.0).clamp(0.0, 10.0);
+        return Ok((Some(Cue::Move(proto::MoveParams { vx, vy, vyaw }, secs)), format!("{{\"ok\":true,\"duration\":{secs:.2}}}")));
+    }
+    Err("empty cue".to_owned())
+}
+
+fn serve_client(stream: TcpStream, tx: &Sender<Cue>) {
+    let peer = stream.peer_addr().map(|a| a.to_string()).unwrap_or_default();
+    let mut writer = match stream.try_clone() {
+        Ok(w) => w,
+        Err(_) => return,
+    };
+    let reader = BufReader::new(stream);
+    for line in reader.lines() {
+        let Ok(line) = line else { break };
+        if line.trim().is_empty() {
+            continue;
+        }
+        let answer = match parse(&line) {
+            Ok((cue, answer)) => {
+                if let Some(cue) = cue {
+                    tracing::warn!(%peer, ?cue, "cue");
+                    if tx.send(cue).is_err() {
+                        break;
+                    }
+                }
+                answer
+            }
+            Err(e) => {
+                tracing::warn!(%peer, line = %line.trim(), error = %e, "bad cue");
+                format!("{{\"ok\":false,\"error\":{}}}", serde_json::to_string(&e).unwrap_or_default())
+            }
+        };
+        if writer.write_all(format!("{answer}\n").as_bytes()).and_then(|_| writer.flush()).is_err() {
+            break;
+        }
+    }
+}
+
+/// Bind the cue port and serve it from a thread. The receiver is drained by the pad loop.
+pub fn serve(port: u16) -> std::io::Result<Receiver<Cue>> {
+    let listener = TcpListener::bind(("0.0.0.0", port))?;
+    let (tx, rx) = mpsc::channel();
+    std::thread::Builder::new().name("cues".into()).spawn(move || {
+        for stream in listener.incoming() {
+            match stream {
+                Ok(stream) => {
+                    let tx = tx.clone();
+                    std::thread::spawn(move || serve_client(stream, &tx));
+                }
+                Err(e) => tracing::warn!(error = %e, "cue accept failed"),
+            }
+        }
+    })?;
+    Ok(rx)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cues_parse_and_answer() {
+        let (c, a) = parse(r#"{"express":"sad"}"#).unwrap();
+        assert_eq!(c, Some(Cue::Express(Kind::Sad)));
+        assert!(a.starts_with("{\"ok\":true,\"duration\":7.50"), "{a}");
+        let (c, _) = parse(r#"{"skill":"ground_pick"}"#).unwrap();
+        assert_eq!(c, Some(Cue::Skill(proto::Skill::GroundPick)));
+        let (c, _) = parse(r#"{"sound":"chirp"}"#).unwrap();
+        assert_eq!(c, Some(Cue::Sound(proto::SoundTag::Chirp)));
+        let (c, a) = parse(r#"{"move":[0.3,0,0.1],"for":1.5}"#).unwrap();
