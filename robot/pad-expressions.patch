+    fn check_keyframes(kind: Kind, keys: &[(f64, f64, f64, f64, f64)], with_pose: bool) {
+        for &(t, neck, pitch, yaw, body) in keys {
+            let h = head_at(kind, t);
+            assert!((h.neck_pitch - neck).abs() < 0.003, "{kind:?} neck at {t}: {}", h.neck_pitch);
+            assert!((h.head_pitch - pitch).abs() < 0.003, "{kind:?} pitch at {t}: {}", h.head_pitch);
+            assert!((h.head_yaw - yaw).abs() < 0.003, "{kind:?} yaw at {t}: {}", h.head_yaw);
+            if with_pose {
+                let p = pose_at(kind, t).expect("posing");
+                assert!((p.pitch - body).abs() < 0.003, "{kind:?} body at {t}: {}", p.pitch);
+                assert!(p.active);
